# Environment Configuration for India Trip Planner

# Gemini AI API Configuration
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Current Gemini model for travel guide generation
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-2.5-flash-lite

# OpenWeatherMap API Configuration (Optional)
# Get your API key from: https://openweathermap.org/api
WEATHER_API_KEY=your_openweather_api_key_here

# Live Google Hotels listings (optional)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Geoapify (Optional — for full AI-TRAVEL-GUIDE dashboard.html routing & tiles)
# Get your API key from: https://www.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Streamlit Configuration (if needed)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
